[Unit]
Description=demo fastapi application
After=network.target

[Service]
User=ld
Group=ld
WorkingDirectory=/home/ld/app/src/
Environment="PATH=/home/ld/app/venv/bin"
EnvironmentFile=/home/ld/.env
ExecStart=/home/ld/app/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.
main:app --bind 0.0.0.0:8000

[Install]
WantedBy=multi-user.target